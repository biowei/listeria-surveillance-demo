/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Listeria surveillance case study profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Selects bacass's short-read path for Illumina L. monocytogenes isolates. Nothing in
    bacass is removed: the long-read and hybrid branches only run when their params ask
    for them, the same pattern conf/test.config uses.

    Portfolio project on public benchmark data; not a clinical or public-health service.

    Use as follows:
        nextflow run . -profile listeria,docker --input <samplesheet> --kraken2db <db> --outdir <OUTDIR>

    Machine-specific values (input, kraken2db, and later reference, schema and
    AMRFinderPlus database paths) come from the command line or a -params-file, not from
    this file. Set process.resourceLimits for the real machine in a local config.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Listeria surveillance case study'
    config_profile_description = 'Short-read assembly + population surveillance (public benchmark data)'

    assembly_type   = 'short'       // Illumina paired-end only
    assembler       = 'unicycler'   // bacass's tested short-read path
    skip_annotation = true          // chewBBACA does its own gene prediction
    skip_busco      = true          // QUAST + cgMLST loci called (AC1) cover completeness
    skip_kmerfinder = true          // one species check is enough: Kraken2 below
    skip_kraken2    = false         // species/contamination QC gate (AC1); --kraken2db required
    kraken2_memory_mapping = true   // Standard-8's 8 GB hash table under an 8 GB Docker limit
    skip_pycoqc     = true          // Nanopore-only step
    skip_nanoplot   = true          // Nanopore-only step
    skip_toulligqc  = true          // Nanopore-only step
}
